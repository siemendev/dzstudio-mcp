{
  "name": "@dzbot/dzstudio-mcp",
  "version": "0.1.3",
  "description": "MCP server that lets an AI agent join dzStudio collaboration sessions (dzcollab 1) as a headless participant",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siemendev/dzstudio-mcp.git"
  },
  "homepage": "https://dzbot.de/creators/studio",
  "type": "module",
  "bin": {
    "dzstudio-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepublishOnly": "npm run build",
    "lint": "oxlint --deny-warnings",
    "check:package": "publint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "mcp",
    "dayz",
    "dzstudio",
    "ai-agents",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public"
  }
}
