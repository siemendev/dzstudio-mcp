{
  "name": "dzstudio-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent join dzStudio collaboration sessions (dzcollab 1) as a headless participant",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "dzstudio-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
